# ─────────────────────────────────────────────────────────────────────────────
# APP_MODE — how the UI discovers Endee servers. Read at RUNTIME (no rebuild to
# switch). One of:
#   bundled     One server, taken from the env below (NDD_SERVER_URL /
#               NDD_ROOT_TOKEN). The token stays server-side; the browser can't
#               add / import / download servers.
#   independent Servers are user-managed from the UI and persisted to a JSON
#               file (SERVERS_FILE). Add / delete / import / download enabled.
APP_MODE=bundled

# ── Bundled mode ─────────────────────────────────────────────────────────────
# Base URL of the Endee server, reached by the Next server (NOT the browser).
# In docker-compose this is the internal service name, e.g.
# http://endee:8080/api/v2. ENDEE_URL is accepted as a fallback for back-compat.
NDD_SERVER_URL=http://endee:8080/api/v2

# Admin root token. Read SERVER-SIDE only — never sent to the browser. Keep it
# secret. ROOT_TOKEN is accepted as a fallback for back-compat.
NDD_ROOT_TOKEN=

# Optional display name for the bundled server (default "Endee").
# NDD_SERVER_NAME=Endee

# ── Independent mode ─────────────────────────────────────────────────────────
# Path to the user-managed server list (JSON array of { name, url, token }).
# Mount this on a volume so it survives restarts. Default: ./data/servers.json
SERVERS_FILE=./data/servers.json
