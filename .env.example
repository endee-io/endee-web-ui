# Base URL of the Endee server, as reachable from the BROWSER.
# The browser calls the Endee server directly (CORS must be enabled there).
#
# Local dev (next dev): set this and Next will inline it at build time.
# In Docker: this is ignored — set ENDEE_URL on the container instead, which
# the entrypoint injects into /config.js at runtime.
#
# Leave empty to issue same-origin relative requests.
NEXT_PUBLIC_ENDEE_URL=http://localhost:8080

# Base URL of the Endee server used SERVER-SIDE by the /api/databases proxy
# route (admin endpoints). Read on the server, so it need not be reachable from
# the browser. Falls back to NEXT_PUBLIC_ENDEE_URL if unset.
NEXT_PUBLIC_SERVER_URL=http://localhost:8080

# Admin root token used SERVER-SIDE only by the /api/databases proxy route to
# authorize calls to /admin/* endpoints. NOT prefixed with NEXT_PUBLIC_ so it is
# never bundled into the browser. Keep this secret.
ROOT_TOKEN=
